<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Sparkle's keys only. Everything else is still generated by
	     GENERATE_INFOPLIST_FILE and merged on top of this file, so the usual
	     INFOPLIST_KEY_* build settings remain the place to change those.
	     This file exists because Xcode only maps *predefined* INFOPLIST_KEY_*
	     settings into the generated plist — arbitrary ones like SUFeedURL are
	     silently dropped.
	     It lives outside SanePeek/ so the target's synchronized file group
	     doesn't also copy it in as a bundle resource. -->
	<key>SUFeedURL</key>
	<string>https://khatri-viren.github.io/sanepeek/appcast.xml</string>
	<!-- The public half of the Ed25519 pair from Sparkle's generate_keys; the private
	     half lives in the developer's login Keychain and in the SPARKLE_PRIVATE_KEY
	     repository secret. Changing this orphans every installed copy — they only
	     trust the key baked into their own bundle — so it has to stay stable. -->
	<key>SUPublicEDKey</key>
	<string>Ip4mI24ki3NUm8X/r8E+9ABEKu+GvjXpNezFNf6l5tg=</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
</dict>
</plist>
